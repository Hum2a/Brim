{
  "name": "@brim/sync",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --env=\"\"",
    "deploy:staging": "npx turbo run build --filter=@brim/sync && wrangler deploy --env staging",
    "deploy:prod": "npx turbo run build --filter=@brim/sync && wrangler deploy --env production",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@brim/shared": "*",
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@brim/config": "*",
    "@cloudflare/workers-types": "^5.20260815.1",
    "wrangler": "^4.28.0"
  }
}
