{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e6d408ebc85e159e6e22ee963641d342",
  "name": "brim-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "vars": {
    "BRIM_FIXTURES": "0"
  },
  "env": {
    "staging": {
      "name": "brim-api-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "brim-staging.humza-butt.space", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/v1/*", "/health"]
      },
      "vars": {
        "BRIM_FIXTURES": "1",
        "WEB_ORIGIN": "https://brim-staging.humza-butt.space"
      }
    },
    "production": {
      "name": "brim-api-production",
      "workers_dev": true,
      "routes": [{ "pattern": "brim.humza-butt.space", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/v1/*", "/health"]
      },
      "vars": {
        "BRIM_FIXTURES": "0",
        "WEB_ORIGIN": "https://brim.humza-butt.space"
      }
    }
  }
}
