    "./popover": { "types": "./dist/components/popover.d.ts", "import": "./dist/components/popover.js" },
    "./command": { "types": "./dist/components/command.d.ts", "import": "./dist/components/command.js" },
    "./tabs": { "types": "./dist/components/tabs.d.ts", "import": "./dist/components/tabs.js" },
    "./tooltip": { "types": "./dist/components/tooltip.d.ts", "import": "./dist/components/tooltip.js" },
    "./skeleton": { "types": "./dist/components/skeleton.d.ts", "import": "./dist/components/skeleton.js" },
    "./drawer": { "types": "./dist/components/drawer.d.ts", "import": "./dist/components/drawer.js" },
